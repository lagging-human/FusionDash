{
  "name": "Apple Music",
  "palette": {
    "pageBackground": "#000000",
    "bodyText": "#f5f5f7",
    "neutral": {
      "300": "#c7c7cc",
      "400": "#8e8e93",
      "500": "#636366",
      "600": "#48484a",
      "700": "#3a3a3c",
      "800": "#2c2c2e",
      "900": "#1c1c1e",
      "950": "#000000"
    },
    "accent": {
      "300": "#fd8b98",
      "400": "#fc5c6e",
      "500": "#fa2d48",
      "600": "#e01e3c"
    },
    "success": "#30d158",
    "danger": "#ff453a",
    "warning": "#ffd60a"
  },
  "sections": {
    "sidebar": {
      "background": "rgba(28,28,30,.55)",
      "border": "rgba(255,255,255,.08)",
      "text": "#a1a1aa",
      "textHover": "#ffffff",
      "textActive": "#ffffff",
      "activeBg": "rgba(255,255,255,.08)",
      "width": "17rem"
    },
    "header": {
      "background": "rgba(0,0,0,.6)",
      "border": "rgba(255,255,255,.08)"
    },
    "card": {
      "background": null,
      "border": null,
      "hoverBackground": null
    }
  },
  "typography": {
    "fontFamily": "'SF Pro Display','-apple-system','BlinkMacSystemFont','Inter',system-ui,sans-serif",
    "fontSource": "google",
    "googleFontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap",
    "customFontUrl": null,
    "baseFontSize": "16px",
    "headingFontFamily": null,
    "headingGoogleFontUrl": null,
    "weightNormal": 400,
    "weightMedium": 500,
    "weightSemibold": 600,
    "weightBold": 700,
    "letterSpacing": "-0.01em",
    "headingLetterSpacing": "-0.02em",
    "lineHeight": "1.47",
    "monoFontFamily": "'SF Mono','JetBrains Mono',ui-monospace,monospace"
  },
  "layout": {
    "radiusScale": 1.5,
    "cardShadow": "0 8px 30px rgba(0,0,0,.5)",
    "spaceScale": 1.05,
    "borderWidth": "1px",
    "sidebarPosition": "left",
    "sidebarCollapsed": false,
    "navStyle": "both",
    "cardGridMinWidth": "300px"
  },
  "effects": {
    "glass": true,
    "glassBlur": "20px",
    "glassOpacity": 0.7,
    "gradientBg": true,
    "gradientStops": [
      "#1a0010 0%",
      "#2a0018 35%",
      "#000000 75%"
    ],
    "gradientAngle": "135deg",
    "gradientType": "radial",
    "noise": false,
    "overlayTint": "light"
  },
  "animations": {
    "enabled": true,
    "speed": "0.3s",
    "style": "blur",
    "cardHover": true,
    "buttonTransition": true,
    "glowAccent": true
  },
  "images": {
    "logoUrl": null,
    "loginBackgroundUrl": null,
    "bodyBackgroundUrl": null
  },
  "customCss": "",
  "buttons": {
    "shape": "pill",
    "fill": "solid"
  }

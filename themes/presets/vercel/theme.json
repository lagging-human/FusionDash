  "typography": {
    "fontFamily": "'Geist','Inter',system-ui,sans-serif",
    "fontSource": "google",
    "googleFontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap",
    "customFontUrl": null,
    "baseFontSize": "16px",

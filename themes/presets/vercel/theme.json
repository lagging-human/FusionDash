      "800": "#eaeaea",
      "900": "#fafafa",
      "950": "#ffffff"
    },
    "accent": {
      "300": "#808080",
      "400": "#404040",
      "500": "#000000",
      "600": "#000000"
    },
    "success": "#0070f3",
    "danger": "#ee0000",
    "warning": "#f5a623"

    "accent":  { "300": "#b3afff", "400": "#8b85ff", "500": "#635bff", "600": "#4b42e0" },
    "success": "#3ecf8e", "danger": "#ff5470", "warning": "#f5a623"
  },
  "sections": {
    "sidebar": { "background": "#0a0a0f", "border": "rgba(150,120,255,.15)", "text": "#9999b3", "textHover": "#ffffff", "textActive": "#ffffff", "activeBg": "rgba(150,120,255,.12)", "width": "16rem" },
    "header":  { "background": "#0a0a0f", "border": "rgba(150,120,255,.15)" },
    "card":    { "background": null, "border": "rgba(150,120,255,.15)", "hoverBackground": null }
  },
  "typography": {
    "fontFamily": "'Inter',system-ui,sans-serif",

{
  "name": "Notion",
  "palette": {
    "pageBackground": "#ffffff",
    "bodyText": "#37352f",
    "neutral": { "950": "#ffffff", "900": "#f7f6f3", "800": "#efeeea", "700": "#e3e1dc", "600": "#c9c7c0", "500": "#9a9793", "400": "#6f6e69", "300": "#37352f" },
    "accent":  { "300": "#8ab8ee", "400": "#5499e7", "500": "#2383e2", "600": "#1a6bc4" },
    "success": "#2f9e44", "danger": "#e03131", "warning": "#f08c00"
  },
  "sections": {
    "sidebar": { "background": "#f7f6f3", "border": "#e3e1dc", "text": "#6f6e69", "textHover": "#37352f", "textActive": "#37352f", "activeBg": "#efeeea", "width": "15.5rem" },
    "header":  { "background": "#ffffff", "border": "#e3e1dc" },
    "card":    { "background": "#ffffff", "border": "#e3e1dc", "hoverBackground": "#f7f6f3" }
  },
  "typography": {
    "fontFamily": "'Inter',system-ui,sans-serif",

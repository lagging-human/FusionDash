<!doctype html>
<html lang="en">
<%- include('../components/header') %>
<body>
<%- include('../components/sidebar', { activePage:'email' }) %>
<div class="app-main">

  <% if (error) { %>
  <div class="flex gap-x-3 border-b border-amber-500/20 bg-amber-500/10 px-4 py-3 sm:px-6 lg:px-8">
    <svg class="h-5 w-5 text-amber-400 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
    <p class="text-sm text-amber-300"><%= error %></p>
  </div>
  <% } %>
  <% if (success) { %>
  <div class="flex gap-x-3 border-b border-green-500/20 bg-green-500/10 px-4 py-3 sm:px-6 lg:px-8">
    <svg class="h-5 w-5 text-green-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
    <p class="text-sm text-green-300"><%= success %></p>
  </div>
  <% } %>

  <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6 lg:px-8 border-b border-white/[0.06] bg-white/[0.02]">
    <div>
      <p class="text-xs text-zinc-500">Email Broadcast</p>
      <p class="text-sm font-semibold text-white mt-0.5">Email</p>
    </div>
  </div>

  <%- include('../components/admin_tabs', { adminTab: 'email' }) %>

  <div class="px-4 sm:px-6 lg:px-8 py-6 pb-24 space-y-5 max-w-2xl">

    <% if (!smtpConfigured) { %>
    <div class="rounded-2xl border border-amber-400/10 bg-amber-400/5 p-5">
      <p class="text-sm font-medium text-amber-400">SMTP isn't configured</p>
      <p class="text-xs text-amber-400/70 mt-1">Set <code>SMTP_HOST</code>, <code>SMTP_PORT</code>, <code>SMTP_USER</code> and <code>SMTP_PASS</code> in <code>.env</code> before sending a broadcast.</p>
    </div>
    <% } %>

    <!-- Usage -->
    <div class="rounded-2xl border border-white/[0.06] overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 bg-white/[0.02] border-b border-white/[0.06]">
        <p class="text-sm font-semibold text-white">Today's SMTP usage</p>
        <p class="text-xs text-zinc-500"><%= usage.sent %> / <%= usage.limit %> sent</p>
      </div>
      <div class="p-5">
        <div class="w-full h-2 rounded-full bg-zinc-800 overflow-hidden">
          <div class="h-full <%= usage.remaining === 0 ? 'bg-red-500' : (usage.sent / usage.limit) > 0.8 ? 'bg-amber-500' : 'bg-blue-500' %>"
            style="width: <%= Math.min(100, Math.round((usage.sent / usage.limit) * 100)) %>%"></div>
        </div>
        <p class="mt-2 text-xs text-zinc-600">
          <%= usage.remaining %> send<%= usage.remaining !== 1 ? 's' : '' %> left today. This budget is shared with password-reset and sign-up emails —
          adjust the daily limit under Settings if your provider allows more.
        </p>
      </div>
    </div>

    <!-- Compose -->
    <form action="/admin/email" method="POST" class="rounded-2xl border border-white/[0.06] overflow-hidden"
      onsubmit="return confirm('Send this email to all <%= recipientCount %> user(s)? This can\'t be undone.')">
      <div class="flex items-center justify-between px-5 py-3 bg-white/[0.02] border-b border-white/[0.06]">
        <p class="text-sm font-semibold text-white">Compose Broadcast</p>
        <p class="text-xs text-zinc-500"><%= recipientCount %> recipient<%= recipientCount !== 1 ? 's' : '' %></p>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <label class="block text-xs text-zinc-500 mb-1">Subject</label>
          <input type="text" name="subject" maxlength="200" required
            class="block w-full rounded-lg border-none py-2 pl-3 bg-zinc-900 text-white ring-1 ring-inset ring-zinc-700 focus:ring-blue-400 text-sm" placeholder="Scheduled maintenance this weekend">
        </div>
        <div>
          <label class="block text-xs text-zinc-500 mb-1">Message</label>
          <textarea name="body" rows="8" required
            class="block w-full rounded-lg border-none py-2 pl-3 bg-zinc-900 text-white ring-1 ring-inset ring-zinc-700 focus:ring-blue-400 text-sm resize-y"
            placeholder="Write your message here. Each user gets it addressed to them by name."></textarea>
          <p class="mt-1 text-xs text-zinc-600">Sent to every user with an email on file, one at a time, in the background — this page will redirect immediately.</p>
        </div>
        <button type="submit" <%= !smtpConfigured || recipientCount === 0 ? 'disabled' : '' %>
          class="rounded-full bg-blue-500/15 px-6 py-2 text-sm font-semibold text-blue-400 ring-1 ring-inset ring-blue-500/30 hover:bg-blue-500/25 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
          Send to All Users
        </button>
      </div>
    </form>
  </div>
</div>
</body>
</html>

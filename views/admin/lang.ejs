<!doctype html>
<html lang="en">
<%- include('../components/header') %>
<body>
<%- include('../components/sidebar', { activePage:'lang' }) %>
<div class="app-main">

  <% if (success) { %>
  <div class="flex gap-x-3 border-b border-green-500/20 bg-green-500/10 px-4 py-3 sm:px-6 lg:px-8">
    <svg class="h-5 w-5 text-green-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
    <p class="text-sm text-green-300"><%= success %></p>
  </div>
  <% } %>

  <div class="px-4 py-4 sm:px-6 lg:px-8 border-b border-white/[0.06] bg-white/[0.02]">
    <p class="text-sm font-semibold text-white">Site Text</p>
  </div>

  <div class="px-4 sm:px-6 lg:px-8 py-6 pb-24 space-y-4 max-w-3xl">

    <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-4">
      <p class="text-xs text-zinc-500 leading-relaxed">
        Edit any label below and save — changes are live immediately, no restart needed.
        Clear a field back to empty to reset it to the default shown as its placeholder.
        This is a starting set (navigation labels); more of the app's text gets wired up the same way over time.
      </p>
    </div>

    <form action="/admin/lang/update" method="POST" class="space-y-4">
      <% 
        const groups = {};
        entries.forEach(e => {
          const groupKey = e.key.split('.')[0];
          (groups[groupKey] ||= []).push(e);
        });
        const groupLabels = { nav: 'Navigation', currency: 'Currency' };
      %>
      <% Object.keys(groups).forEach(g => { %>
      <div class="rounded-2xl border border-white/[0.06] overflow-hidden">
        <div class="px-5 py-3 bg-white/[0.02] border-b border-white/[0.06]">
          <p class="text-sm font-semibold text-white"><%= groupLabels[g] || g %></p>
        </div>
        <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% groups[g].forEach(e => { %>
          <div>
            <label class="block text-xs text-zinc-500 mb-1 font-mono"><%= e.key %></label>
            <input type="text" name="key__<%= e.key %>" value="<%= e.override !== null ? e.override : '' %>" placeholder="<%= e.default %>"
              class="block w-full rounded-lg border-none py-2 pl-3 bg-zinc-900 text-white ring-1 ring-inset ring-zinc-700 focus:ring-blue-400 text-sm placeholder:text-zinc-600">
          </div>
          <% }) %>
        </div>
      </div>
      <% }) %>

      <button type="submit" class="rounded-full bg-blue-500/15 px-6 py-2.5 text-sm font-semibold text-blue-400 ring-1 ring-inset ring-blue-500/30 hover:bg-blue-500/25 transition-colors">
        Save
      </button>
    </form>

  </div>
</div>
</body>
</html>

<!doctype html>
<html lang="en">
<%- include('../components/header') %>
<body>
<%- include('../components/sidebar', { activePage }) %>
<div class="app-main">

  <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6 lg:px-8 border-b border-white/[0.06] bg-white/[0.02]">
    <div class="min-w-0">
      <p class="text-xs text-zinc-500"><a href="/servers" class="hover:text-zinc-300 transition-colors">My Servers</a> <span class="text-zinc-700">/ <%= server.name %></span></p>
      <p class="text-sm font-semibold text-white mt-0.5 truncate"><%= server.name %></p>
    </div>
    <% if (panelUrl) { %>
    <a href="<%= panelUrl %>" target="_blank" class="inline-flex items-center gap-x-2 rounded-full bg-blue-500/15 px-4 py-2 text-xs font-semibold text-blue-400 ring-1 ring-inset ring-blue-500/30 hover:bg-blue-500/25 transition-colors shrink-0">
      Open in Pterodactyl
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
    </a>
    <% } %>
  </div>

  <div class="px-4 sm:px-6 lg:px-8 py-6 pb-24 space-y-4 max-w-4xl">

    <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-5">
      <p class="text-xs font-semibold text-zinc-400 mb-3">Server Details</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Plan</p><p class="text-white mt-0.5 capitalize"><%= server.plan %></p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Memory</p><p class="text-white mt-0.5"><%= (server.memory/1024).toFixed(1) %> GiB</p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Disk</p><p class="text-white mt-0.5"><%= (server.disk/1024).toFixed(1) %> GiB</p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">CPU</p><p class="text-white mt-0.5"><%= (server.cpu/100).toFixed(1) %> vCore</p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Ports</p><p class="text-white mt-0.5"><%= server.ports %></p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Databases</p><p class="text-white mt-0.5"><%= server.databases %></p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Backups</p><p class="text-white mt-0.5"><%= server.backups %></p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Created</p><p class="text-white mt-0.5"><%= new Date(server.created_at).toLocaleDateString() %></p></div>
      </div>
      <% if (server.description) { %>
      <p class="text-xs text-zinc-500 mt-4 pt-4 border-t border-white/[0.06]"><%= server.description %></p>
      <% } %>
    </div>

    <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] overflow-hidden">
      <div class="px-5 py-3 border-b border-white/[0.06]">
        <p class="text-xs font-semibold text-zinc-400">Audit History <span class="text-zinc-700 font-normal">(admin actions on this server)</span></p>
      </div>
      <% if (auditEntries.length === 0) { %>
      <p class="text-sm text-zinc-600 px-5 py-6 text-center">No admin actions recorded for this server yet.</p>
      <% } else { %>
      <div class="divide-y divide-white/[0.04]">
        <% auditEntries.forEach(e => { %>
        <div class="px-5 py-3 flex items-center justify-between gap-x-3">
          <div class="min-w-0">
            <p class="text-sm text-zinc-300"><%= e.action %></p>
            <p class="text-[11px] text-zinc-600 mt-0.5">by <%= e.admin_name || e.admin_id %></p>
          </div>
          <p class="text-[11px] text-zinc-600 shrink-0"><%= new Date(e.created_at).toLocaleString() %></p>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>

    <% if (!panelUrl) { %>
    <p class="text-[11px] text-zinc-700">No Pterodactyl panel link available for this server yet.</p>
    <% } %>

  </div>
</div>
</body>
</html>

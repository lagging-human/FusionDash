<!doctype html>
<html lang="en">
<%- include('../components/header') %>
<body>
<%- include('../components/sidebar', { activePage:'servers' }) %>
<div class="app-main">
  <%- include('./_tabs') %>

  <% if (success) { %>
  <div class="flex gap-x-3 border-b border-green-500/20 bg-green-500/10 px-4 py-3 sm:px-6 lg:px-8"><p class="text-sm text-green-300"><%= success %></p></div>
  <% } %>

  <div class="px-4 sm:px-6 lg:px-8 py-6 pb-24 space-y-4 max-w-2xl">

    <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-5">
      <p class="text-xs font-semibold text-zinc-400 mb-3">Rename</p>
      <form action="/server/<%= server.id %>/settings/rename" method="POST" class="space-y-3">
        <div>
          <label class="block text-[10px] text-zinc-600 mb-1">Server Name</label>
          <input type="text" name="name" value="<%= details.name %>" required
            class="block w-full rounded-lg border-none py-2 pl-3 bg-zinc-900 text-white ring-1 ring-inset ring-zinc-700 focus:ring-blue-400 text-sm">
        </div>
        <div>
          <label class="block text-[10px] text-zinc-600 mb-1">Description</label>
          <input type="text" name="description" value="<%= details.description || '' %>"
            class="block w-full rounded-lg border-none py-2 pl-3 bg-zinc-900 text-white ring-1 ring-inset ring-zinc-700 focus:ring-blue-400 text-sm">
        </div>
        <button type="submit" class="rounded-full bg-blue-500/15 px-5 py-2 text-xs font-semibold text-blue-400 ring-1 ring-inset ring-blue-500/30 hover:bg-blue-500/25 transition-colors">
          Save
        </button>
      </form>
    </div>

    <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-5">
      <p class="text-xs font-semibold text-zinc-400 mb-3">Server Info</p>
      <div class="grid grid-cols-2 gap-3 text-xs">
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Identifier</p><p class="text-zinc-300 font-mono mt-0.5"><%= details.identifier %></p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Node</p><p class="text-zinc-300 mt-0.5"><%= details.node || '—' %></p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Memory Limit</p><p class="text-zinc-300 mt-0.5"><%= details.limits?.memory %> MB</p></div>
        <div><p class="text-[10px] text-zinc-600 uppercase tracking-wide">Disk Limit</p><p class="text-zinc-300 mt-0.5"><%= details.limits?.disk %> MB</p></div>
      </div>
    </div>

  </div>
</div>
</body>
</html>

<!doctype html>
<html lang="en">
<%- include('../components/header') %>
<body>
<%- include('../components/sidebar', { activePage:'servers' }) %>
<div class="app-main">
  <%- include('./_tabs') %>

  <div class="px-4 sm:px-6 lg:px-8 py-6 pb-24 max-w-4xl">

    <div class="flex items-center justify-between gap-x-3 mb-3 flex-wrap gap-y-2">
      <div class="flex items-center gap-x-1.5 text-xs text-zinc-500 min-w-0">
        <a href="/server/<%= server.id %>/files?dir=<%= encodeURIComponent(dir) %>" class="hover:text-zinc-300 transition-colors shrink-0">&larr; Files</a>
        <span class="text-zinc-700 shrink-0">/</span>
        <span class="font-mono truncate"><%= filePath %></span>
      </div>
      <% if (!looksBinary) { %>
      <button type="submit" form="editForm" class="rounded-full bg-blue-500/15 px-5 py-2 text-xs font-semibold text-blue-400 ring-1 ring-inset ring-blue-500/30 hover:bg-blue-500/25 transition-colors shrink-0">
        Save
      </button>
      <% } %>
    </div>

    <% if (looksBinary) { %>
    <div class="rounded-2xl border border-dashed border-white/[0.08] p-8 text-center">
      <p class="text-sm text-zinc-500">This doesn't look like a text file — can't edit it here.</p>
      <p class="text-xs text-zinc-700 mt-1">Use the Pterodactyl panel directly for binary files, jars, or archives.</p>
    </div>
    <% } else { %>
    <form id="editForm" action="/server/<%= server.id %>/files/edit" method="POST">
      <input type="hidden" name="path" value="<%= filePath %>">
      <textarea name="content" spellcheck="false"
        class="block w-full h-[60vh] rounded-2xl border-none py-3 px-4 bg-black/60 text-zinc-200 ring-1 ring-inset ring-white/[0.06] focus:ring-blue-400 text-[13px] font-mono leading-relaxed resize-y"
      ><%= content %></textarea>
    </form>
    <p class="text-[11px] text-zinc-700 mt-2">Saves directly to the server — no confirmation dialog, so double check before hitting Save.</p>
    <% } %>

  </div>
</div>
</body>
</html>

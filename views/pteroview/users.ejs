<!doctype html>
<html lang="en">
<%- include('../components/header') %>
<body>
<%- include('../components/sidebar', { activePage:'servers' }) %>
<div class="app-main">
  <%- include('./_tabs') %>

  <% if (error) { %>
  <div class="flex gap-x-3 border-b border-amber-500/20 bg-amber-500/10 px-4 py-3 sm:px-6 lg:px-8"><p class="text-sm text-amber-300"><%= error %></p></div>
  <% } %>
  <% if (success) { %>
  <div class="flex gap-x-3 border-b border-green-500/20 bg-green-500/10 px-4 py-3 sm:px-6 lg:px-8"><p class="text-sm text-green-300"><%= success %></p></div>
  <% } %>

  <div class="px-4 sm:px-6 lg:px-8 py-6 pb-24 space-y-4 max-w-4xl">

    <div class="rounded-2xl border border-white/[0.06] overflow-hidden">
      <% if (subusers.length === 0) { %>
      <p class="text-sm text-zinc-600 px-5 py-6 text-center">No subusers yet.</p>
      <% } else { %>
      <div class="divide-y divide-white/[0.04]">
        <% subusers.forEach(su => { %>
        <div class="flex items-center justify-between gap-x-3 px-5 py-3">
          <div class="min-w-0">
            <p class="text-sm text-zinc-300 truncate"><%= su.username || su.email %></p>
            <p class="text-[11px] text-zinc-600 mt-0.5"><%= (su.permissions||[]).length %> permission<%= (su.permissions||[]).length===1?'':'s' %></p>
          </div>
          <form action="/server/<%= server.id %>/users/<%= su.uuid %>/remove" method="POST" onsubmit="return confirm('Remove <%= su.username || su.email %>?')">
            <button type="submit" class="text-[11px] text-red-400/70 hover:text-red-400 transition-colors shrink-0">Remove</button>
          </form>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>

    <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-5">
      <p class="text-xs font-semibold text-zinc-400 mb-3">Invite a subuser</p>
      <form action="/server/<%= server.id %>/users/invite" method="POST" class="space-y-3">
        <input type="email" name="email" placeholder="their@email.com" required
          class="block w-full rounded-lg border-none py-2 pl-3 bg-zinc-900 text-white ring-1 ring-inset ring-zinc-700 focus:ring-blue-400 text-sm">
        <div>
          <label class="block text-[10px] text-zinc-600 mb-1">Permissions <span class="text-zinc-700">(comma-separated Pterodactyl permission keys)</span></label>
          <input type="text" name="permissions" placeholder="control.console, control.start, control.stop"
            class="block w-full rounded-lg border-none py-2 pl-3 bg-zinc-900 text-white ring-1 ring-inset ring-zinc-700 focus:ring-blue-400 text-sm font-mono placeholder:text-zinc-700">
        </div>
        <button type="submit" class="rounded-full bg-blue-500/15 px-5 py-2 text-xs font-semibold text-blue-400 ring-1 ring-inset ring-blue-500/30 hover:bg-blue-500/25 transition-colors">
          Send Invite
        </button>
      </form>
    </div>

  </div>
</div>
</body>
</html>

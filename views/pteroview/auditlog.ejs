<!doctype html>
<html lang="en">
<%- include('../components/header') %>
<body>
<%- include('../components/sidebar', { activePage:'servers' }) %>
<div class="app-main">
  <%- include('./_tabs') %>

  <div class="px-4 sm:px-6 lg:px-8 py-6 pb-24 max-w-3xl">
    <div class="rounded-2xl border border-white/[0.06] overflow-hidden">
      <% if (entries.length === 0) { %>
      <p class="text-sm text-zinc-600 px-5 py-8 text-center">No actions recorded for this server yet.</p>
      <% } else { %>
      <div class="divide-y divide-white/[0.04]">
        <% entries.forEach(e => { %>
        <div class="px-5 py-3 flex items-center justify-between gap-x-3">
          <div class="min-w-0">
            <p class="text-sm text-zinc-300"><%= e.action %></p>
            <p class="text-[11px] text-zinc-600 mt-0.5">by <%= e.admin_name || e.admin_id %></p>
          </div>
          <p class="text-[11px] text-zinc-600 shrink-0"><%= new Date(e.created_at).toLocaleString() %></p>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>

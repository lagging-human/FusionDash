<!doctype html>
<html lang="en">
<%- include('../components/header') %>
<body>
<%- include('../components/sidebar', { activePage:'servers' }) %>
<div class="app-main">
  <%- include('./_tabs') %>

  <% if (success) { %>
  <div class="flex gap-x-3 border-b border-green-500/20 bg-green-500/10 px-4 py-3 sm:px-6 lg:px-8"><p class="text-sm text-green-300"><%= success %></p></div>
  <% } %>

  <div class="px-4 sm:px-6 lg:px-8 py-6 pb-24 space-y-3 max-w-3xl">

    <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-4">
      <p class="text-[10px] text-zinc-600 uppercase tracking-wide">Startup Command</p>
      <p class="text-xs text-zinc-400 font-mono mt-1 break-all"><%= meta?.startup_command || meta?.raw_startup_command || '—' %></p>
    </div>

    <% variables.forEach(v => { %>
    <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-4">
      <p class="text-sm text-zinc-300"><%= v.name %></p>
      <p class="text-[11px] text-zinc-600 mt-0.5 mb-3"><%= v.description %></p>
      <% if (v.is_editable) { %>
      <form action="/server/<%= server.id %>/startup/update" method="POST" class="flex gap-x-2">
        <input type="hidden" name="key" value="<%= v.env_variable %>">
        <input type="text" name="value" value="<%= v.server_value %>"
          class="flex-1 rounded-lg border-none py-2 pl-3 bg-zinc-900 text-white ring-1 ring-inset ring-zinc-700 focus:ring-blue-400 text-sm font-mono">
        <button type="submit" class="rounded-lg bg-blue-500/15 px-4 text-xs font-semibold text-blue-400 ring-1 ring-inset ring-blue-500/30 hover:bg-blue-500/25 transition-colors">Save</button>
      </form>
      <% } else { %>
      <p class="text-xs text-zinc-500 font-mono bg-zinc-900 rounded-lg px-3 py-2"><%= v.server_value %> <span class="text-zinc-700">(read-only)</span></p>
      <% } %>
    </div>
    <% }) %>

  </div>
</div>
</body>
</html>
